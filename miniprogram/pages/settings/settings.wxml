<view class="settings-page">
  <!-- P1 ①：用「本周概览」替代原空头像占位卡，把日程治理价值前置到常驻页 -->
  <view class="card overview {{canTap ? 'tappable' : ''}}" bindtap="onOverviewTap">
    <view class="ov-head">
      <view class="ov-head-title">本周概览</view>
      <view class="ov-head-range">{{weekRange}}</view>
    </view>
    <view class="ov-divider"></view>
    <view class="ov-stats">
      <view class="ov-stat">
        <text class="ov-num">{{weekCount}}</text>
        <text class="ov-label">本周日程</text>
      </view>
      <view class="ov-stat">
        <text class="ov-num {{ddlSoon ? 'warn' : ''}}">{{ddlSoon}}</text>
        <text class="ov-label">临近截止</text>
      </view>
      <view class="ov-stat">
        <text class="ov-num {{conflictCount ? 'warn' : ''}}">{{conflictCount}}</text>
        <text class="ov-label">时间冲突</text>
      </view>
    </view>
    <view class="ov-tip {{conflictCount ? 'alert' : ''}}">{{overviewTip}}</view>
  </view>

  <view class="group">
    <view class="cell" bindtap="goPrivacy"><text>隐私协议</text><text class="arrow">></text></view>
    <view class="cell" bindtap="onFeedback"><text>识别有误反馈</text><text class="arrow">></text></view>
  </view>

  <view class="group">
    <view class="cell"><text>版本</text><text class="sub">{{version}}</text></view>
  </view>
</view>
