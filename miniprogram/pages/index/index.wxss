.hero { padding: 40rpx 32rpx 20rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; display: block; line-height: 1.4; }
.hero-sub { font-size: 26rpx; color: #6b7280; margin-top: 12rpx; display: block; }
.steps { display: flex; align-items: center; margin-top: 28rpx; }
.step { display: flex; flex-direction: column; align-items: center; flex: 1; }
.step-no { width: 56rpx; height: 56rpx; border-radius: 50%; background: #07c160; color: #fff; font-size: 28rpx; line-height: 56rpx; text-align: center; font-weight: 600; }
.step-txt { font-size: 24rpx; color: #333; margin-top: 10rpx; }
.step-arrow { color: #c4c9d0; font-size: 28rpx; margin: 0 6rpx; }
.input-bar { display: flex; justify-content: flex-end; margin-bottom: 8rpx; }
.ib-btn { font-size:26rpx; color:#6b7280; padding:4rpx 8rpx; }
.ib-btn.primary { color:#07c160; font-weight:600; }
.input { width:100%; min-height:200rpx; font-size:28rpx; }
.parse-btn { margin:8rpx 24rpx 0; }
.recent-item { display:flex; justify-content:space-between; align-items:center; }
.ri-title { font-size: 28rpx; font-weight: 500; }
.ri-date { font-size: 24rpx; color: #9aa0a6; }

/* 隐私授权弹窗 */
.privacy-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; z-index: 100; }
.privacy-dialog { width: 80%; background: #fff; border-radius: 16rpx; padding: 40rpx 32rpx; box-sizing: border-box; }
.privacy-title { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.privacy-content { font-size: 28rpx; color: #555; line-height: 1.6; margin-bottom: 32rpx; }
.privacy-actions { display: flex; gap: 16rpx; }
.pb-btn { flex: 1; font-size: 28rpx; margin: 0; padding: 0; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; text-align: center; }
.pb-btn::after { border: none; }
.pb-btn.primary { background: #07c160; color: #fff; }
.pb-btn.ghost { background: #f2f2f2; color: #333; }
