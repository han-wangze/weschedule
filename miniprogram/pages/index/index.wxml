<view class="page">
  <!-- 价值前置：三格示意替代原 logo hero（B1） -->
  <view class="hero">
    <text class="hero-title">把群里的日程，自动整理好</text>
    <view class="steps">
      <view class="step"><text class="step-no">1</text><text class="step-txt">复制群消息</text></view>
      <text class="step-arrow">→</text>
      <view class="step"><text class="step-no">2</text><text class="step-txt">一键粘贴</text></view>
      <text class="step-arrow">→</text>
      <view class="step"><text class="step-no">3</text><text class="step-txt">拆成日程</text></view>
    </view>
  </view>

  <view class="card">
    <view class="input-bar">
      <text wx:if="{{inputText}}" class="ib-btn" bindtap="onClearInput">清空</text>
    </view>
    <textarea class="input" placeholder="粘贴群消息到这里进行解析~" value="{{inputText}}" bindinput="onInput" maxlength="2000" auto-height />
  </view>

  <button class="btn-primary parse-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onParse">{{parseBtnText}}</button>

  <view wx:if="{{recent.length}}" class="section-title">最近日程</view>
  <view wx:for="{{recent}}" wx:key="_id" class="card recent-item">
    <text class="ri-title">{{item.title}}</text>
    <text class="ri-date">{{item.date}} {{item.start_time}}</text>
  </view>

  <view wx:if="{{showPrivacy}}" class="privacy-mask">
    <view class="privacy-dialog">
      <view class="privacy-title">隐私授权</view>
      <view class="privacy-content">WeSchedule 需要读取你复制的文本以识别其中的日程。文本仅用于当次解析，默认不留存原文。</view>
      <view class="privacy-actions">
        <button class="pb-btn ghost" bindtap="onViewPrivacy">查看协议</button>
        <button class="pb-btn" bindtap="onDisagreePrivacy">暂不</button>
        <button id="agree-btn" class="pb-btn primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacy">同意</button>
      </view>
    </view>
  </view>
</view>
