<view class="page">
  <view class="hero">
    <text class="hero-title">WeSchedule</text>
    <text class="hero-sub">复制群消息，自动解析成日程</text>
  </view>

  <view wx:if="{{hasClipboard}}" class="clip-bar">
    <view class="clip-text-wrap">
      <text class="clip-label">检测到剪贴板</text>
      <text class="clip-text">{{clipboardTip}}</text>
    </view>
    <button class="clip-btn" size="mini" bindtap="onParse">解析</button>
  </view>

  <!-- 未同意隐私协议：不自动读剪贴板，改由用户点击触发授权，避免每次进入都弹窗 -->
  <view wx:if="{{needPrivacy}}" class="privacy-bar">
    <view class="pb-text">
      <text class="pb-title">需要同意隐私协议</text>
      <text class="pb-sub">同意后即可自动识别剪贴板里的群消息；也可以直接在下方粘贴文本。</text>
    </view>
    <button class="pb-btn" size="mini" bindtap="onAuthorizeAndRead">同意并读取</button>
  </view>

  <view class="card">
    <view wx:if="{{inputText}}" class="clear-row">
      <text class="clear-btn" bindtap="onClearInput">清空</text>
    </view>
    <textarea class="input" placeholder="也可以把群消息粘贴到这里" value="{{inputText}}" bindinput="onInput" maxlength="2000" auto-height />
  </view>

  <button class="btn-primary parse-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onParse">解析日程</button>

  <view wx:if="{{recent.length}}" class="section-title">最近日程</view>
  <view wx:for="{{recent}}" wx:key="_id" class="card recent-item">
    <text class="ri-title">{{item.title}}</text>
    <text class="ri-date">{{item.date}} {{item.start_time}}</text>
  </view>
</view>
