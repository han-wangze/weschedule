.list-page { padding-bottom: 40rpx; }
.empty { text-align:center; color:#9aa0a6; font-size:28rpx; margin-top:160rpx; }
.empty-text { display:block; margin-bottom:24rpx; }
.empty-btn { display:inline-block; background:#07c160; color:#fff; font-size:28rpx; padding:0 40rpx; }
.date-head { font-size:26rpx; color:#9aa0a6; margin:24rpx 28rpx 4rpx; }
/* 没有日期的事件单独成区，用琥珀色区分，避免和日期分组混在一起 */
.date-head.pending-head { color:#ad6800; font-weight:600; }
/* 过期项收在列表最后，最多 5 条，视觉上压暗 */
.date-head.expired-head { color:#b0b3b8; }
.item-expired { opacity:.62; }
.item-wrap { position:relative; overflow:hidden; margin:8rpx 24rpx; }
.item {
  background:#fff; border-radius:16rpx; padding:24rpx;
  transition: transform 0.2s ease;
  display:flex; align-items:center;
  /* 关键：卡片必须自己建立层叠上下文，才能盖住下面的删除按钮。
     absolute 元素（.del-btn）默认画在 static 元素之上——不给卡片
     position+z-index 的话，删除按钮会常驻显示在卡片上，左滑只是
     把内容拖走（2026-10-21 真机反馈的"删除一直显现"就是这个）。 */
  position: relative; z-index: 1;
}
.item-main { display:flex; flex-direction:column; }
.item-title-row { display:flex; align-items:center; }
.item-title { font-size:30rpx; font-weight:500; }
.conflict-tag { margin-left:12rpx; font-size:22rpx; color:#e54d42; background:#fdecec; border:1rpx solid #f5c6c6; border-radius:8rpx; padding:2rpx 10rpx; }
.item-time { font-size:24rpx; color:#9aa0a6; margin-top:6rpx; }
.del-btn {
  position:absolute; top:0; right:0; bottom:0; width:120rpx;
  background:#e54d42; color:#fff; font-size:28rpx;
  display:flex; align-items:center; justify-content:center;
  border-radius:0 16rpx 16rpx 0;
  /* 画在卡片下面（卡片 z-index:1），只有左滑让位才露出来 */
  z-index: 0;
}
