<view class="list-page">
  <view wx:if="{{!groups.length}}" class="empty">
    <text class="empty-text">还没有日程</text>
    <button class="empty-btn" bindtap="goHome">去首页解析群消息</button>
  </view>
  <block wx:for="{{groups}}" wx:for-item="g" wx:key="date">
    <view class="date-head">{{g.date}}</view>
    <view wx:for="{{g.items}}" wx:for-item="item" wx:key="_id" class="item-wrap">
      <view class="item"
            bindtouchstart="onTouchStart"
            bindtouchmove="onTouchMove"
            bindtouchend="onTouchEnd"
            data-id="{{item._id}}"
            style="transform: translateX({{offsets[item._id] || 0}}px);">
        <view class="item-main">
          <view class="item-title-row">
            <text class="item-title">{{item.title}}</text>
            <text wx:if="{{item.conflict}}" class="conflict-tag">⚠冲突</text>
          </view>
          <text class="item-time" wx:if="{{item.start_time}}">{{item.start_time}}<text wx:if="{{item.location}}" class="item-loc">　📍 {{item.location}}</text></text>
          <text class="item-time" wx:else>{{item.fuzzy_time || '时间待定'}}<text wx:if="{{item.location}}" class="item-loc">　📍 {{item.location}}</text></text>
        </view>
      </view>
      <view class="del-btn" data-id="{{item._id}}" bindtap="onDelete">删除</view>
    </view>
  </block>
</view>
