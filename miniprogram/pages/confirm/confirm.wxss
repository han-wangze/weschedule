/* 确认页布局：顶部警示区 + 中部 swiper + 底部按钮，全部走正常文档流。
   2026-10-21 真机反馈两轮后的最终形态：
   ① 底部按钮曾被 swiper 顶出可视区 → 曾改 fixed 钉住，但钉在屏幕最底会让
      内容不满一屏时中间空一块、按钮视觉"沉"（用户第二轮反馈）；
   ② 现改为：swiper 高度 = min(可用空间, 卡片内容自然高度 + 余量)。
      内容不满一屏时卡片下沿紧贴按钮，按钮跟着内容走而不是钉在屏幕底；
      内容超高时才封顶为可用空间，卡片内部滚动。
   ⚠️ 踩过的坑仍别用：height:100vh + page{overflow:hidden} 会整页白屏
   （100vh 高于可视区且禁滚，内容被推出后滚不回来）；swiper 用绝对定位撑高会塌成 0。 */
.confirm-page { padding-bottom: 0; }

.hint { text-align: center; color: #9aa0a6; font-size: 24rpx; margin: 16rpx 0; }

.swiper { width: 100%; }
.form-scroll { height: 100%; }
.form-tail { height: 20rpx; }

.row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.row:last-child { border-bottom: none; }
.label { width: 200rpx; color: #9aa0a6; font-size: 28rpx; flex-shrink: 0; }
.field { flex: 1; font-size: 30rpx; }
.picker-value { flex: 1; font-size: 30rpx; color: #333; padding: 6rpx 0; }
.switch-row { justify-content: space-between; }
.fuzzy { flex: 1; color: #b8860b; font-size: 28rpx; }
/* 无日期的日程不会提醒（remind 直接跳过），界面上不留一个假的"30 分钟" */
.no-remind { flex: 1; color: #b0b3b8; font-size: 24rpx; line-height: 1.4; }

/* 底部按钮区：跟随内容，不钉屏幕底。内容不满一屏时紧贴卡片下方，
   视觉重心不下沉；内容超高时页面可滚，按钮在内容末尾 */
.bottom {
  background: #f5f6f8;
  margin-top: 8rpx;
  /* iOS 全面屏底部横条安全区（home indicator），两行写法兼容旧基础库 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.feedback-link { text-align: center; color: #fa5151; font-size: 26rpx; margin: 12rpx 0 4rpx; text-decoration: underline; }
.actions { display: flex; margin: 8rpx 24rpx 0; gap: 20rpx; }
.actions button { flex: 1; }

/* 冲突内联警示（非阻断，不弹窗） */
.warn { display: flex; align-items: center; margin: 16rpx 24rpx 0; padding: 16rpx 20rpx; border-radius: 12rpx; font-size: 26rpx; line-height: 1.4; }
.warn-hard { background: #fdecec; color: #e54d42; border: 1rpx solid #f5c6c6; }
.warn-soft { background: #fff7e6; color: #ad6800; border: 1rpx solid #ffe0a3; }
/* 模糊日程的边界说明：不是警示，用中性色，避免和真冲突抢注意力 */
.warn-info { background: #f2f3f5; color: #5f6368; border: 1rpx solid #e4e6eb; }
.warn-icon { margin-right: 10rpx; }
/* 规则法空闲槽建议 chip */
.slots { display: flex; flex-wrap: wrap; align-items: center; margin: 12rpx 24rpx 0; }
.slots-tip { font-size: 26rpx; color: #9aa0a6; margin-right: 8rpx; }
.chip { background: #eef2ff; color: #4f46e5; border: 1rpx solid #d6defc; border-radius: 999rpx; padding: 10rpx 22rpx; margin: 8rpx 10rpx 0 0; font-size: 26rpx; }
