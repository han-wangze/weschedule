.confirm-page { padding-bottom: 40rpx; }
.hint { text-align:center; color:#9aa0a6; font-size:24rpx; margin:16rpx 0; }
.swiper { height: 720rpx; }
.row { display:flex; align-items:center; padding:18rpx 0; border-bottom:1rpx solid #f0f2f5; }
.label { width:200rpx; color:#9aa0a6; font-size:28rpx; flex-shrink:0; }
.field { flex:1; font-size:30rpx; }
.picker-value { flex:1; font-size:30rpx; color:#333; padding:6rpx 0; }
.switch-row { justify-content:space-between; }
.fuzzy { flex:1; color:#b8860b; font-size:28rpx; }
.feedback-link { text-align:center; color:#fa5151; font-size:26rpx; margin:12rpx 0 4rpx; text-decoration:underline; }
.actions { display:flex; margin:24rpx; gap:20rpx; }
.actions button { flex:1; }
