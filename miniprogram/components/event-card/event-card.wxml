<view class="ec-card {{event.confidence < 0.8 ? 'ec-warn' : ''}}">
  <view class="ec-head">
    <text class="ec-title">{{event.title}}</text>
    <view wx:if="{{event.confidence < 0.8}}" class="ec-badge">请核对</view>
  </view>
  <view class="ec-row"><text class="ec-label">日期</text><text class="ec-value">{{event.date}}</text></view>
  <view class="ec-row"><text class="ec-label">时间</text><text class="ec-value">{{timeText}}</text></view>
  <view class="ec-row" wx:if="{{event.location}}"><text class="ec-label">地点</text><text class="ec-value">{{event.location}}</text></view>
  <view class="ec-row" wx:if="{{peopleText}}"><text class="ec-label">参与人</text><text class="ec-value">{{peopleText}}</text></view>
  <view class="ec-row" wx:if="{{event.fuzzy_time}}"><text class="ec-label">模糊时间</text><text class="ec-value">{{event.fuzzy_time}}</text></view>
  <view class="ec-tags"><text wx:if="{{event.is_deadline}}" class="ec-tag">截止日</text></view>
</view>
