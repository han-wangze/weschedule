.ec-card { background:#fff; border-radius:16rpx; padding:24rpx; }
.ec-warn { border:2rpx solid #ffc107; }
.ec-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:12rpx; }
.ec-title { font-size:34rpx; font-weight:600; }
.ec-badge { background:#fff3cd; color:#b8860b; font-size:22rpx; padding:4rpx 14rpx; border-radius:20rpx; }
.ec-row { display:flex; padding:6rpx 0; }
.ec-label { width:130rpx; color:#9aa0a6; font-size:26rpx; flex-shrink:0; }
.ec-value { flex:1; font-size:28rpx; color:#1f1f1f; }
.ec-tags { margin-top:10rpx; }
.ec-tag { background:#fdecea; color:#e54d42; font-size:22rpx; padding:4rpx 14rpx; border-radius:20rpx; }
